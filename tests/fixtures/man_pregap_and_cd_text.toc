// cdrdao(1) "Standard track with two second pre-gap, ISRC code and CD-TEXT".
// Note the two ISRC spellings: the track-level code is undashed, the CD-TEXT
// one is dashed.
CD_DA
 CD_TEXT {
   LANGUAGE_MAP {
     0 : EN
   }

  LANGUAGE 0 {
     TITLE "CD Title"
     PERFORMER "Performer"
     DISC_ID "XY12345"
     UPC_EAN ""
   }
 }

TRACK AUDIO
 ISRC "DEXXX9800001"
 CD_TEXT {
   LANGUAGE 0 {
     TITLE "Track Title"
     PERFORMER "Performer"
     ISRC "DE-XXX-98-00001"
   }
 }
 PREGAP 0:2:0
 FILE "a.wav" 0
